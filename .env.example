# Mode aplikasi: public atau private.
# Pada Docker Compose, APP_MODE ditetapkan per service.
APP_MODE=public

# Docker Compose development — placeholder dummy, bukan kredensial produksi.
POSTGRES_USER=dacie_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=dacie_dev

# Port lokal aplikasi (hanya diikat ke 127.0.0.1).
WEB_PUBLIC_PORT=3001
WEB_PRIVATE_PORT=3002

# --- Mode public ---
# Instance public hanya menerima kredensial app_public dan secret CAPTCHA.
# Untuk menjalankan mode public, jangan sertakan variabel mode private.
APP_PUBLIC_DATABASE_URL=postgresql://app_public:change-me-local-only@db:5432/dacie_dev
CAPTCHA_SECRET=change-me-local-only-captcha-secret

# --- Mode private ---
# Instance private hanya menerima kredensial app_private dan secret sesi.
# Untuk menjalankan mode private, jangan sertakan variabel mode public.
APP_PRIVATE_DATABASE_URL=postgresql://app_private:change-me-local-only@db:5432/dacie_dev
SESSION_SECRET=change-me-local-only-session-secret
