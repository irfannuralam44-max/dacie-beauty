# Mode aplikasi untuk development tanpa Docker: public atau private.
# Pada Docker Compose, APP_MODE ditetapkan per service.
APP_MODE=public

# Docker Compose development — placeholder dummy, bukan kredensial produksi.
POSTGRES_USER=dacie_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=dacie_dev

# Port lokal aplikasi (hanya diikat ke 127.0.0.1).
WEB_PUBLIC_PORT=3001
WEB_PRIVATE_PORT=3002

# Placeholder dummy untuk task berikutnya; jangan isi secret nyata di repo.
# DATABASE_URL=postgresql://user:password@localhost:5432/dacie_beauty
# CAPTCHA_SECRET=replace-with-secret
